                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "record_state": {
                "const": "terminal"
              },
              "execution_status": {
                "const": "completed"
              },
              "trace_coverage": {
                "const": "complete_for_declared_invariants"
              },
              "predicates": {
                "minItems": 1,
                "items": {
                  "if": {
                    "properties": {
                      "required": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "status": {
                        "const": "pass"
                      }
                    }
                  }
                }
              },
              "violations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authorized_success": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "missingness_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
